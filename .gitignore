# Dependencies and builds
node_modules/
dist/
dist-holding/
dist-holding-dev/
build/
.vite/
# The dev hostname adapter's compiled Function (its `test` script) and the
# empty static directory its deploy creates (#429)
apps/dev-hosts/.build/
apps/dev-hosts/public/
# Astro's generated types (`astro sync`, run by build and check)
.astro/
coverage/
# The coverage record is committed, like the floors (#728, #748): only the
# coverage tools' output folders above stay out.
!/tests/coverage/
reports/mutation/

# Test output
playwright-report/
test-results/
# Written by record-floors.yml's rehearse job (scripts/rehearse.ts, #771) and
# laid over the tree before Measure: never committable, or the committable-file
# walks would count it.
/rehearsal/
# Written by `npm run test:pacing`; CI uploads it as an artifact (#35)
pacing-report.json

# Cloudflare local state
.wrangler/
.dev.vars
# Written at deploy by scripts/d1-binding.ts with the D1 database id (#391)
wrangler.deploy.jsonc
# Generated on install by `wrangler types` (root postinstall)
apps/sync-worker/worker-configuration.d.ts
apps/web/worker/worker-configuration.d.ts
apps/site/worker/worker-configuration.d.ts
apps/dev-hosts/functions/worker-configuration.d.ts

# Session-local agent files (brainstorm mockups, SDD scratch)
.superpowers/
# The mutation runner's logs and reports (#527).
.mutations/
.remember/

# OS
.DS_Store
