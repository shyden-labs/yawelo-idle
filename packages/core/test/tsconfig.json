{
  // The core tests run in Node under vitest, so they see Node's types, while the package's own tsconfig.json
  // keeps `src/` (and the golden vectors, bundled into each browser engine)
  // to ECMAScript alone.
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "erasableSyntaxOnly": true,
    "types": ["node"]
  },
  "include": ["**/*.ts", "../src/**/*.ts", "../fixtures/**/*.ts"]
}
