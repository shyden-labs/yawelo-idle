{
  // The core properties (#543) run in Node under vitest, like the unit tests
  // whose checks they share (../test), so they see Node's types, as
  // test/tsconfig.json does. The shared checks under
  // ../test come in by import.
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "erasableSyntaxOnly": true,
    "types": ["node"]
  },
  "include": ["**/*.ts", "../src/**/*.ts", "../fixtures/**/*.ts"]
}
