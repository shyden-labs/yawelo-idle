{
  // The core logs suite (#84, spec §5.12): the event log's checks, run in CI
  // before a release. Like the properties beside it they run in Node under
  // vitest and share the unit tests' checks (../test), so they see Node's
  // types.
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "erasableSyntaxOnly": true,
    "types": ["node"]
  },
  "include": ["**/*.ts", "../src/**/*.ts", "../fixtures/**/*.ts"]
}
