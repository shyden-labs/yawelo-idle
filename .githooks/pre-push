#!/usr/bin/env bash
# The static gates (#123, Shyden 2026-10-06): format,
# lint and typecheck (tsc and svelte-check), the checks that need no test lock
# and fail in seconds to a minute. No test suite runs here (#547, Shyden
# 2026-10-12: "No unit in pre-push"): the laptop runs no suite but the unit
# suite (global rule 2026-10-09), and a branch that adds floors fails the unit
# suite until CI records them, so a unit run here would refuse the push the
# record needs. The unit suite runs by hand before each push; every suite runs
# in CI on the pull request.
# `npm install` installs this hook: the root `prepare` script points git's
# core.hooksPath at .githooks.
set -euo pipefail

npm run --silent format:check
npm run --silent lint
npm run --silent typecheck
