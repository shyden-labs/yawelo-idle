// The DEV sync Worker (spec §6.7). Production gets its own config when the
// production pipeline is built; until then this file describes dev only.
{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "yawelo-idle-sync-dev",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-20",
  // The sync API, in the non-PROD account (#784): no dev credential may
  // reach the production account that holds the yaweloidle.com zone, so dev
  // has no Custom Domain. It is served at dev-api.yaweloidle.com through the
  // front door (apps/door, #1013), which reaches its workers.dev address. Not password-gated: the Worker marks non-prod responses
  // noindex instead (src/index.ts). No preview URLs.
  "workers_dev": true,
  "preview_urls": false,
  "vars": {
    // Overwritten at deploy time with `--var COMMIT:<sha>`, so /health can
    // prove which commit is live. "local" never matches a SHA.
    "COMMIT": "local",
    // The sign-up switch (#1079): "open" or "closed"; anything else is closed.
    "SIGNUPS": "open",
    // The origin refuses a request without its door secret (#784 AC4,
    // #1078 AC3); only "false" admits every request.
    "DOOR_REQUIRED": "true",
  },
  // Named, with no id, so no id is ever copied in by hand. The deploy creates
  // the database when it is missing (scripts/ensure-d1.ts, #357), then binds
  // it by id through a git-ignored copy of this file, wrangler.deploy.jsonc
  // (scripts/d1-binding.ts, #391): bound by name alone, a recreated database
  // fails to deploy with 7404.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "yawelo-idle-dev",
      "migrations_dir": "migrations",
    },
  ],
}
