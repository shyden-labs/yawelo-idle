// TEST ONLY (#506), never deployed: the sync Worker wrapped by
// test/injected-worker.ts, which changes one thing in its environment per
// request (a commit) inside workerd. Everything but `name`
// and `main` must equal wrangler.jsonc: test/health.test.ts refuses any drift.
{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "yawelo-idle-sync-injected",
  "main": "test/injected-worker.ts",
  "compatibility_date": "2026-10-20",
  "workers_dev": true,
  "preview_urls": false,
  "vars": {
    "COMMIT": "local",
    // "false" until the doors go live on 2026-11-15 (#784 AC4); the deploy
    // then sets "true" with DOOR_SECRET, and any other value requires the door.
    "DOOR_REQUIRED": "false",
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "yawelo-idle-dev",
      "migrations_dir": "migrations",
    },
  ],
}
