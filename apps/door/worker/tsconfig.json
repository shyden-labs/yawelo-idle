{
  // The front door Worker: it sees the Workers runtime (generated by
  // `wrangler types`) and nothing from Node or the DOM.
  "compilerOptions": {
    "erasableSyntaxOnly": true,
    "target": "ES2024",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2024"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": ["./worker-configuration.d.ts"]
  },
  "include": ["*.ts"]
}
