{
  "extends": "astro/tsconfigs/strictest",
  "compilerOptions": {
    "erasableSyntaxOnly": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true
  },
  "include": [".astro/types.d.ts", "**/*"],
  "exclude": [
    "dist",
    "dist-holding",
    "dist-holding-dev",
    "worker",
    "test/roadmap-worker",
    "test/roadmap"
  ]
}
