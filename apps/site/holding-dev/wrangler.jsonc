{
  "$schema": "../../../node_modules/wrangler/config-schema.json",
  // The holding page's dev copy (#621 AC8): the production holding build with
  // crawlers blocked and every response noindex (scripts/holding-dev.ts), in
  // the non-PROD account (#784), so Shyden checks it on his phones before a
  // release. The front door serves it at dev-holding.yaweloidle.com (#768,
  // #1013), since Indonesian providers block free shared domains; its own
  // workers.dev address is where its door reaches it (#784). It holds nothing private, since it is what goes
  // public, but like every origin behind a door it serves only a request
  // carrying the door secret: its script (../worker/holding.ts) runs before
  // its files. Deployed by deploy-dev.yml.
  "name": "yawelo-idle-holding-dev",
  "main": "../worker/holding.ts",
  "compatibility_date": "2026-10-20",
  "workers_dev": true,
  "preview_urls": false,
  "assets": {
    "directory": "../dist-holding-dev",
    "binding": "ASSETS",
    "run_worker_first": true,
    "not_found_handling": "404-page",
  },
  "vars": {
    // "false" until the doors go live on 2026-11-15, as the other origins:
    // the deploy then sets "true" with DOOR_SECRET, and any other value
    // requires the door.
    "DOOR_REQUIRED": "false",
  },
}
