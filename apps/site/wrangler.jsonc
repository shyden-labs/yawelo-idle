// The DEV site Worker (website spec §7.2, #332, #673), all behind the shared
// dev password (#39, W15): /play/* forwarded to the game Worker by service
// binding, the roadmap API and webhook, and the pages: the prerendered site
// being built, from ./dist, through the front door, dev.yaweloidle.com
// (#1013), and at the workers.dev address alike (Shyden, 2026-11-28, #1078).
//
// Cloudflare serves a matching asset WITHOUT invoking a Worker unless
// `run_worker_first` is set, so the gate in worker/index.ts would never see
// the request. Here it is set, and every request pays one invocation;
// production can serve its pages without the Worker and keep them free
// (#425 AC2).
{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "yawelo-idle-site-dev",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-20",
  // Deployed to the non-PROD account (#784) with no Custom Domain:
  // dev.yaweloidle.com reaches it through the front door (apps/door, #1013).
  // Its workers.dev address is where the site being built is seen (#673),
  // behind the same gate, and it also tells a door fault from a Worker fault.
  // No preview URLs.
  "workers_dev": true,
  "preview_urls": false,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": true,
    // An unknown path gets the nearest 404.html: /id/… the Indonesian one.
    "not_found_handling": "404-page",
  },
  // The game Worker has no address of its own; this binding is its only way
  // in, so it is deployed first.
  "services": [{ "binding": "GAME", "service": "yawelo-idle-web-dev" }],
  // The live roadmap (#341): the one board it reads, as the read-only App
  // yawelo-idle-roadmap; its snapshot lives in the Roadmap Durable Object
  // (SQLite storage, the only kind on the Free plan, spec §10 R1), and a
  // visit re-reads the whole board once the last read is 10 minutes old, which
  // catches a missed webhook (#1074; there is no cron).
  // The App key and webhook secret are Worker secrets from the deploy.
  "vars": {
    // ShyDesk's dev host (#860, relayed by shydesk-b1 2026-11-22); it moves
    // with shyden-labs/shydesk#262 (#1076).
    "SHYDESK_HOST": "https://shydesk.shydesk-non-prod.workers.dev",
    "ROADMAP_APP_ID": "5294556",
    "ROADMAP_BOARD_ID": "PVT_kwDOEOcG584BlRWb",
    "ROADMAP_BOARD_TITLE": "Yawelo Idle Stories",
    "ROADMAP_REPO": "shyden-labs/yawelo-idle",
    // "false" until the doors go live on 2026-11-15 (#784 AC4); the deploy
    // then sets "true" with DOOR_SECRET, and any other value requires the door.
    "DOOR_REQUIRED": "false",
  },
  // The Worker version, so a deploy's first visit reads the board with the
  // new code (#1074).
  "version_metadata": { "binding": "CF_VERSION_METADATA" },
  "durable_objects": {
    "bindings": [{ "name": "ROADMAP", "class_name": "Roadmap" }],
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Roadmap"] }],
}
