---
/**
 * The privacy page, in English and Indonesian only (Shyden, 2026-11-08,
 * global rule; #928). The English page carries the one translated note for
 * readers of each language without legal text; today every language has it.
 */
import Base from '../layouts/Base.astro';
import { COPY, LEGAL } from '../copy';
import { LOCALES, localesOf, type LegalLocale } from '../i18n';

interface Props {
  locale: LegalLocale;
}
const { locale } = Astro.props;
const text = LEGAL[locale].privacy;
const noted =
  locale === 'en'
    ? LOCALES.filter((other) => !localesOf('privacy').includes(other))
    : [];
---

<Base locale={locale} page="privacy" title={text.title}>
  {noted.map((other) => (
    <p lang={other} data-english-only-note>
      {COPY[other].englishOnlyNote}
    </p>
  ))}
  <h1>{text.title}</h1>
  <p data-governing-language>{text.governs}</p>
  <p>{text.soon}</p>
</Base>
