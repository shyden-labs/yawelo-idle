---
/**
 * The privacy page, in English and Indonesian (Shyden, 2026-11-08, global
 * rule; #928). Each copy says which text governs for whom. The English copy
 * also carries the one translated note for readers of any language that has
 * no legal text (none today).
 */
import Base from '../layouts/Base.astro';
import { COPY, LEGAL } from '../copy';
import { LOCALES, localesOf, type LegalLocale } from '../i18n';

interface Props {
  locale: LegalLocale;
}
const { locale } = Astro.props;
const legal = LEGAL[locale].privacy;
const withoutLegalText =
  locale === 'en'
    ? LOCALES.filter((reader) => !localesOf('privacy').includes(reader))
    : [];
---

<Base locale={locale} page="privacy" title={legal.title}>
  {withoutLegalText.map((reader) => (
    <p lang={reader} data-english-only-note>
      {COPY[reader].englishOnlyNote}
    </p>
  ))}
  <h1>{legal.title}</h1>
  <p data-governing-language>{legal.governs}</p>
  <p>{legal.soon}</p>
</Base>
