---
/**
 * The privacy page, in English only (Shyden, 2026-11-08, global rule; #925).
 * Every language links here; each other language's readers get the one
 * translated note a legal page may carry, marked with that language.
 */
import Base from '../layouts/Base.astro';
import { COPY, LEGAL } from '../copy';
import { LOCALES } from '../i18n';

const others = LOCALES.filter((locale) => locale !== 'en');
---

<Base locale="en" page="privacy" title={LEGAL.privacy.title}>
  {others.map((locale) => (
    <p lang={locale} data-english-only-note>
      {COPY[locale].englishOnlyNote}
    </p>
  ))}
  <h1>{LEGAL.privacy.title}</h1>
  <p>{LEGAL.privacy.soon}</p>
</Base>
