# The holding page's headers (#621), applied by Cloudflare to every static
# asset response. No script or style is inline, so the policy needs no hash.
/*
  Content-Security-Policy: default-src 'none'; script-src 'self'; style-src 'self'; img-src 'self'; media-src 'self'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'
  X-Content-Type-Options: nosniff
  Referrer-Policy: no-referrer
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=(), interest-cohort=()

# shyden.co.uk may embed the promo video (same site); other sites may not.
/media/*
  Cross-Origin-Resource-Policy: same-site
