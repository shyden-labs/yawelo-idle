{
  "$schema": "../../../node_modules/wrangler/config-schema.json",
  // The production holding page (#621): yaweloidle.com (#1013), in Yawelo's
  // own production account, which holds the yaweloidle.com zone; the old
  // yawelo-idle.shyden.co.uk redirects to it from the shyden.co.uk zone. Assets only: no
  // script runs, so no page view counts against a request limit ("Requests to
  // static assets are free and unlimited", Cloudflare, read 2026-10-16) and
  // its security headers come from public/_headers. The full site replaces it
  // under the same name later (#425). Deployed only by deploy-prod.yml.
  "name": "yawelo-idle-site",
  "compatibility_date": "2026-10-20",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [{ "pattern": "yaweloidle.com", "custom_domain": true }],
  "assets": {
    "directory": "../dist-holding",
    "not_found_handling": "404-page",
  },
}
